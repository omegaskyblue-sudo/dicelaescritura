# Copia este archivo a .env y rellena las claves. Nunca subas .env al repositorio.
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
# Opcional
CLAUDE_MODEL=claude-opus-5-5
# Base de datos (opcional). Con ella: pantalla de login y datos compartidos por el equipo.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/estudio_faceless
# Acceso: usuarios propios (usuario:contraseña separados por comas)
ACCESS_USERS=
# o una contraseña común para todos
ACCESS_PASSWORD=
PORT=3000
