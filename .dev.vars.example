# Copia a .dev.vars para desarrollo local (npm run dev). Nunca lo subas al repositorio.
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
# Usuarios iniciales (solo si la base de datos está vacía). El primero será administrador.
ACCESS_USERS=root:cambia-esta-clave

# Solo para pruebas locales: apuntar a un servidor que imite la API de Fliki
# FLIKI_API_URL=http://localhost:8902
# ANTHROPIC_BASE_URL=http://localhost:8903   (pruebas: servidor que imite la API de Claude)
